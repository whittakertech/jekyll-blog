{
  "name": "whittakertech-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/site.css --watch=always",
    "build:css-prod": "tailwindcss -i ./assets/css/main.css -o ./assets/css/site.css --minify",
    "dev": "concurrently \"npm run build:css\" \"bundle exec jekyll serve --livereload\"",
    "build": "npm run build:css-prod && bundle exec jekyll build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.3.3"
  }
}
